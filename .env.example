# Copy to .env and fill in. Never commit .env.

# ── Grok (xAI) — used by POST /api/extract and POST /api/structures ──
# Get a key at https://console.x.ai
XAI_API_KEY=
# Optional, defaults to grok-4
XAI_MODEL=grok-4

# GROK_TRANSPORT=grokbot: send Grok calls through the signed-in Grok Bot desktop app (macOS)
# instead of XAI_API_KEY. One-time setup: npx tsx agent/bot/setup-grokbot.ts
GROK_TRANSPORT=

# DEMO_MODE=1: Grok served only from fixtures/cache (no network, throws on cache miss)
# and the property store uses the in-memory CSV index instead of Supabase.
DEMO_MODE=0
# Optional: override the Grok response cache dir (defaults to fixtures/cache)
# GROK_CACHE_DIR=

# ── Supabase (optional) ──
# If URL + a key are unset, the app falls back to the in-memory index built from data/raw/*.csv.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Needed for writes (e.g. loading data/raw into the properties table).
SUPABASE_SERVICE_ROLE_KEY=

# ── UI ──
# Anything except "false" makes the UI use fixtures/sample.json instead of calling the API routes.
NEXT_PUBLIC_USE_FIXTURES=true
